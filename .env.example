# App name (optional)
# Comes from package.json "name" by default, set this to override it
# Allowed: string, 4-255 characters
# PACKAGE_NAME_OVERRIDE=review-result

# App description (optional)
# Comes from package.json "description" by default, set this to override it
# Allowed: string, 4-455 characters
# PACKAGE_DESCRIPTION_OVERRIDE=Application for reviewing assessment results

# App version (optional)
# Comes from package.json "version" by default, set this to override it
# Allowed: valid semver (e.g. 1.0.0, 2.1.3-beta.1)
# PACKAGE_VERSION_OVERRIDE=0.1.0

# Environment
# Allowed values: development | production
NODE_ENV=development

# Server host
# Allowed: valid hostname, IPv4, or IPv6
HOST=0.0.0.0

# Server port
# Allowed: 1-65535
PORT=3000

# Log level
# Allowed values: silent | trace | debug | info | warn | error | fatal
LOG_LEVEL=debug


# Enable logging to stdout
# Allowed values: true | false
LOG_STDOUT_ENABLED=true


# Log output format
# Allowed values: json | pretty
LOG_STDOUT_FORMAT=pretty


# Enable logging to a file
# Allowed values: true | false
LOG_FILE_ENABLED=false

# Max Log File size
# Maximum size of a log file before rotation
# Allowed: positive integer followed by k, m, or g (case-insensitive)
# Examples: 500k, 10m, 1g
LOG_FILE_MAX_SIZE=10m

# Log File Rotation
# Number of rotated log files to keep
# Allowed: 1-365
LOG_FILE_MAX_FILES=7

# Log File Path
# default: ./log/app
LOG_FILE_PATH=./log/app
