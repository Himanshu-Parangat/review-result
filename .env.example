# =============================================================================
# Application
# =============================================================================

# App name (optional)
# Comes from package.json "name" by default, set this to override it
# Allowed: string, 4-255 characters
# PACKAGE_NAME_OVERRIDE=review-result

# App description (optional)
# Comes from package.json "description" by default, set this to override it
# Allowed: string, 4-455 characters
# PACKAGE_DESCRIPTION_OVERRIDE=Application for reviewing assessment results

# App version (optional)
# Comes from package.json "version" by default, set this to override it
# Allowed: valid semver (e.g. 1.0.0, 2.1.3-beta.1)
# PACKAGE_VERSION_OVERRIDE=0.1.0

# Runtime environment
# Allowed values: development | production
NODE_ENV=development


# =============================================================================
# HTTP server
# =============================================================================

# Address the server binds to
# Use 127.0.0.1 for local-only access, 0.0.0.0 to listen on all interfaces
# Allowed: valid hostname, IPv4, or IPv6
SERVER_BIND_HOST=127.0.0.1

# Server port
# Port the server listens on
# Allowed: 1-65535
SERVER_PORT=3000


# =============================================================================
# Database
# =============================================================================

# Which database backend to use
# Allowed values: memory | sqlite
#   memory - in-process, data is lost on restart (good for tests/dev)
#   sqlite - file-based, uses SQLITE_DB_PATH
DB_MODE=sqlite

# SQLite database file path (optional, used when DB_MODE=sqlite)
# Allowed: non-empty string
# Default: src/db/store/store.db
SQLITE_DB_PATH=src/db/store/store.db

# SQLite journal mode (required, used when DB_MODE=sqlite)
# Allowed values (lowercase): delete | truncate | persist | memory | wal | off
#   wal      - recommended. Changes go to a separate -wal file, so readers don't
#              block the writer and the writer doesn't block readers. Creates
#              extra -wal and -shm files next to the database. Don't use on
#              network filesystems.
#   delete   - SQLite's classic default. A rollback journal file is created for
#              each transaction and deleted on commit. Crash-safe, but writers
#              block readers and readers block writers.
#   truncate - like delete, but truncates the journal to zero bytes instead of
#              deleting it. Can be faster on some filesystems.
#   persist  - like delete, but keeps the journal file and only zeroes its header.
#   memory   - keeps the rollback journal in RAM. Fast, but a crash during a
#              transaction can corrupt the database. Avoid in production.
#   off      - no rollback journal at all. ROLLBACK stops working properly and a
#              crash or error mid-transaction can corrupt the database. Avoid in
#              production.
SQLITE_JOURNAL_MODES=wal

# SQLite synchronous mode (required, used when DB_MODE=sqlite)
# Allowed values (lowercase): off | normal | full | extra
#   off    - SQLite hands data to the OS and doesn't wait for it to reach disk.
#            Fastest. An application crash is safe, but a power failure or OS
#            crash can corrupt the database. Avoid in production.
#   normal - syncs at the most critical moments only. In WAL mode this is
#            safe from corruption, but the last few committed transactions can
#            be lost on power failure. Recommended together with wal.
#            In non-WAL modes there is a small risk of corruption on power loss.
#   full   - syncs to disk at every critical moment, so committed data survives
#            power failure. Safe in all journal modes, but slower. SQLite's own
#            default, and the better choice if you can't afford to lose commits.
#   extra  - like full, but also syncs the directory containing the rollback
#            journal after it is deleted. Only matters in non-WAL modes (and
#            mostly on older filesystems). Slowest.
SQLITE_SYNCHRONOUS_MODES=full

# How long SQLite waits on a locked database before failing (optional)
# Allowed: integer, 0-60000 (milliseconds)
# Default: 5000
SQLITE_BUSY_TIMEOUT_MS=5000

# SQLite page cache size (optional)
# Allowed: integer, 0-1024 (megabytes)
# Default: 64
SQLITE_CACHE_SIZE_MB=64

# SQLite page size in bytes (optional)
# Allowed: power of two, 512-65536
# Default: 4096
# Note: only takes effect on a new database file. For an existing file it
# changes only after a VACUUM.
SQLITE_PAGE_SIZE=4096


# =============================================================================
# Logging
# =============================================================================

# Minimum log level
# Allowed values: silent | trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Log to stdout
# Allowed values: true | false (also accepts 1/0, yes/no, on/off)
LOG_STDOUT_ENABLED=true
 
# Stdout log format
# Allowed values: json | pretty
#   pretty - human-readable, for development
#   json   - structured, for production/log collectors
LOG_STDOUT_FORMAT=pretty
 
# Log to a file
# Allowed values: true | false (also accepts 1/0, yes/no, on/off)
LOG_FILE_ENABLED=false
 
# Max size of a log file before rotation
# Allowed: positive integer followed by k, m, or g (case-insensitive)
# Examples: 500k, 10m, 1g
LOG_FILE_MAX_SIZE=10m
 
# Number of rotated log files to keep
# Allowed: 1-365
LOG_FILE_MAX_FILES=7
 
# Log file path (optional)
# Allowed: non-empty string
# Default: ./log/app
LOG_FILE_PATH=./log/app
