{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "review-result",
	"version": "0.1.0",
	"description": "scheduling assessments, conducting interactive structured evaluations, and reviewing assessment results.",
	"scripts": {
		"check": "bunx biome check",
		"check:fix": "bunx biome check --write",
		"dev": "bun --env-file=.env.development --hot src/index.ts",
		"format": "bunx biome format",
		"format:fix": "bunx biome format --write",
		"lint": "bunx biome lint",
		"lint:fix": "bunx biome lint --write",
		"start": "bun --env-file=.env.production src/index.ts"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@scalar/hono-api-reference": "^0.12.13",
		"hono": "^4.13.13",
		"nanoid": "^6.0.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "latest",
		"typescript": "^7.0.2"
	}
}
