{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "review-result",
	"version": "0.1.0",
	"description": "scheduling assessments, conducting interactive structured evaluations, and reviewing assessment results.",
	"scripts": {
		"check": "bunx biome check && tsc --noEmit",
		"check:fix": "bunx biome check --write && tsc --noEmit",
		"db:sqlite:generate": "bun --env-file=.env.${NODE_ENV:?NODE_ENV is required} drizzle-kit generate --config='./src/db/adapters/sqlite/sqliteMigration.ts'",
		"db:sqlite:migrate": "bun --env-file=.env.${NODE_ENV:?NODE_ENV is required} drizzle-kit migrate --config='./src/db/adapters/sqlite/sqliteMigration.ts'",
		"format": "bunx biome format",
		"format:fix": "bunx biome format --write",
		"lint": "bunx biome lint",
		"lint:fix": "bunx biome lint --write",
		"start": "bun src/index.ts",
		"start:hot": "bun --hot src/index.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@scalar/hono-api-reference": "^0.12.13",
		"drizzle-orm": "^1.0.0-rc.5",
		"hono": "^4.13.13",
		"nanoid": "^6.0.2",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"pino-roll": "^4.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "latest",
		"drizzle-kit": "^1.0.0-rc.5",
		"typescript": "^7.0.2"
	}
}
